PORT=5000
DB_ENGINE=mongo

MONGO_URI=mongodb://localhost:27117/
MONGO_DB=product_demo
MONGO_COLLECTION=products
MONGO_WRITE_CONCERN=1
MONGO_READ_CONCERN=local
MONGO_READ_PREFERENCE=primary

# Atlas backend started by the default Docker stack.
MONGO_ATLAS_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=<app-name>
MONGO_ATLAS_DB=product_demo
MONGO_ATLAS_COLLECTION=products_atlas
MONGO_ATLAS_PORT=5002
MONGO_ATLAS_WRITE_CONCERN=majority
MONGO_ATLAS_READ_CONCERN=majority
MONGO_ATLAS_READ_PREFERENCE=primary

POSTGRES_DSN=postgresql://benchmark:benchmark@localhost:5433/product_demo

DEFAULT_LIMIT=12