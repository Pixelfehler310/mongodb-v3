{
    "name": "mongodb-demo",
    "version": "1.0.0",
    "private": true,
    "description": "Presentation-friendly MongoDB product catalog demo.",
    "scripts": {
        "compose:up": "docker compose up --build",
        "compose:down": "docker compose down",
        "frontend:dev": "npm --prefix frontend run dev",
        "frontend:build": "npm --prefix frontend run build",
        "seed": "python scripts/seed.py",
        "seed:mongo": "set DB_ENGINE=mongo&& python scripts/seed.py",
        "seed:postgres": "set DB_ENGINE=postgres&& python scripts/seed.py",
        "reset": "python scripts/reset_demo.py",
        "demo:health:mongo": "python scripts/demo_case.py --backend mongo health",
        "demo:health:postgres": "python scripts/demo_case.py --backend postgres health",
        "demo:read:mongo": "python scripts/demo_case.py --backend mongo read-aggregate",
        "demo:read:postgres": "python scripts/demo_case.py --backend postgres read-aggregate",
        "demo:rename:mongo": "python scripts/demo_case.py --backend mongo category-rename",
        "demo:rename:postgres": "python scripts/demo_case.py --backend postgres category-rename",
        "demo:migrate:mongo": "python scripts/demo_case.py --backend mongo lazy-migration",
        "demo:migrate:postgres": "python scripts/demo_case.py --backend postgres lazy-migration",
        "start": "python -m backend.app",
        "test": "python -m pytest"
    }
}